
# Если OAuth-приложение создать нельзя: постоянный API key / access token DonationAlerts
DONATIONALERTS_API_KEY=

# Separate user-facing feedback bot (not the admin feedback bot)
FEEDBACK_USER_BOT_TOKEN=
FEEDBACK_USER_BOT_USERNAME=

# Uploaded blog images and chat attachments (persistent, writable by streamhata)
MEDIA_UPLOAD_DIR=/opt/streamhata/uploads

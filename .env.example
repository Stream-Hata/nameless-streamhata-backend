
# Если OAuth-приложение создать нельзя: постоянный API key / access token DonationAlerts
DONATIONALERTS_API_KEY=

# Separate user-facing feedback bot (not the admin feedback bot)
FEEDBACK_USER_BOT_TOKEN=
FEEDBACK_USER_BOT_USERNAME=

# Uploaded blog images and chat attachments (persistent, writable by streamhata)
MEDIA_UPLOAD_DIR=/opt/streamhata/uploads

# Internal token for scanner/worker -> security incidents API
SECURITY_INTERNAL_TOKEN=

# Optional file scanning engines. Without them uploads stay unscanned.
SECURITY_CLAMAV_ADDR=
SECURITY_REPUTATION_URL=

# Blocked uploads are kept here for 24h, then removed automatically.
SECURITY_QUARANTINE_DIR=/opt/streamhata/quarantine

# Optional URL reputation service, receives {"url": "..."} and returns LinkReport.
SECURITY_LINK_REPUTATION_URL=

# Feedback bot diagnostics (SSH tunnels bind to localhost)
LOKI_URL=http://127.0.0.1:3100
PROMETHEUS_URL=http://127.0.0.1:9090

# Modrinth API base (optional override)
MODRINTH_API_URL=https://api.modrinth.com/v2

# CurseForge fingerprint proxy (optional, keeps API key off the backend)
CURSEFORGE_PROXY_URL=

# Anti-spam limits. Set a limit to 0 to disable that check.
SPAM_DM_PER_MINUTE=20
SPAM_DM_PEER_PER_MINUTE=10
SPAM_DISCUSSION_PER_MINUTE=10
SPAM_UPLOAD_PER_MINUTE=10
SPAM_DUPLICATE_WINDOW_SECONDS=300
SPAM_MAX_LINKS=3
SPAM_MAX_MENTIONS=10
